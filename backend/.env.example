# Copy to backend/.env and fill in. Variables already set in the environment win.

# Inngest. Local development needs nothing: `make dev` runs the dev server.
# Production: INNGEST_DEV=0 with both keys from the Inngest dashboard.
# INNGEST_DEV=1
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# The browser agent from python-brain won't start without this, even when
# every SOP step is a scripted Playwright step.
GOOGLE_API_KEY=
# Show the browser while it works (it runs headless by default).
# DO_BROWSER_HEADLESS=0

# ODeX login, read by the SOP's credentials block (sops/odex/README.md).
ODEX_USERNAME=
ODEX_PASSWORD=

# The sites the SOPs open. By default, the local versions (make portals); the
# browser agent may open nothing but this machine unless the allow-list says so
# (comma-separated hosts, or * for any).
# DO_ODEX_URL=http://127.0.0.1:8100/odex
# DO_CMA_RTGS_URL=http://127.0.0.1:8100/cma-rtgs
# DO_BROWSER_ALLOWED_HOSTS=127.0.0.1,localhost
# Run the invoice, payment, deposit and eDO steps with the browser agent as their
# mail arrives (make demo-local turns it on).
# DO_AUTOMATE_PORTALS=

# The local ODeX's demo login, for the portal and its SOPs (sops/local). Not a
# secret: these are the defaults, and that portal only runs on this machine.
# LOCAL_ODEX_USERNAME=hexalog-demo
# LOCAL_ODEX_PASSWORD=local-demo-only
# A folder of real liner invoices for demo shipments (kept out of git): the local ODeX
# releases the one that names the B/L instead of a demo invoice.
# LOCAL_ODEX_INVOICES_DIR=

# Outlook (Microsoft Graph), as in python-brain. Mail reaches the app through a Graph
# subscription that calls WEBHOOK_BASE_URL/api/webhooks/microsoft-graph.
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT_ID=
OUTLOOK_RECIPIENT_EMAIL=
# Public URL of this API: a tunnel (ngrok, cloudflared) that forwards ONLY /api/webhooks/*.
# Never expose /api/inngest: in dev mode it does not check signatures.
WEBHOOK_BASE_URL=
# Logins for the public tunnel, "user:password,user2:password2" (use long passwords). With none set,
# the tunnel serves only the Graph webhook. Local requests need no login.
BASIC_AUTH_USERS=
# Any random string. Graph echoes it in each notification; the webhook drops a mismatch.
GRAPH_CLIENT_STATE=
# Only mail whose body has a line "<prefix>:<stage>:<MBL>[:<arg>]" is processed (no classifier).
# Short tag that marks a mail to be read (a whole word in the subject or body). Empty: any known mail.
# MAIL_MARKER=#DOHACK
# INJECT_CODE_PREFIX=DOHACK
# House bill number formats to find in an HBL file (a regex).
# HBL_PATTERN=(?:WOLSZSE\d{8}[A-Z]|MSEC\d{12})
